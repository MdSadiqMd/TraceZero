# TraceZero Frontend Configuration
# Copy this file to .env and configure for your environment
#
# URL Resolution Strategy:
#   1. If VITE_RELAYER_URL is set, it's used (production)
#   2. If user accesses from localhost, falls back to localhost:8080 (dev)
#   3. This allows testing prod frontend with local backend
#
# Local development (no .env needed):
#   - Run backend: ./scripts/start-tracezero.sh
#   - Open: http://localhost:5173 (vite dev) or the Cloudflare Workers URL
#   - Frontend automatically uses localhost:8080
#
# Production deployment:
#   - Set VITE_RELAYER_URL to your EC2 server IP/domain
#   - Rebuild and deploy: npm run build && npx wrangler deploy

# Tor Gateway URL (for routing traffic through Tor)
# Leave unset for localhost fallback in dev
# VITE_TOR_GATEWAY_URL=http://localhost:3080

# Relayer URL
# Leave unset for localhost:8080 fallback in dev
# Production: Set to your EC2 IP or domain
# Example: VITE_RELAYER_URL=http://ec2-xx-xx-xx-xx.compute.amazonaws.com:8080
# Example: VITE_RELAYER_URL=https://relayer.yourdomain.com
# VITE_RELAYER_URL=

# Solana RPC URL
# IMPORTANT: In production, this should be routed through Tor gateway
# to prevent DNS leaks that reveal you're using Solana
# Default: https://api.devnet.solana.com
# Production example: http://localhost:3080/rpc (proxied to Solana RPC)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Network Configuration
# Options: devnet, mainnet-beta, testnet
VITE_SOLANA_NETWORK=devnet

# Privacy Settings
# Enable strict Tor-only mode (no clearnet fallback)
VITE_TOR_ONLY_MODE=true

# Security Settings
# Enable additional security checks
VITE_ENABLE_SECURITY_CHECKS=true
