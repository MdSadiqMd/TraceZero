# Solana RPC
# Devnet: https://api.devnet.solana.com
# Mainnet: your private RPC node URL (routed through Tor via Privoxy)
# In Docker, this value is used AS-IS by the relayer.
# The HTTP_PROXY env var in docker-compose.prod.yml routes it through Tor.
RPC_URL=https://api.devnet.solana.com

# Key Paths
# Paths INSIDE the container (mapped from ./keys/ on the host via volume mount)
# Host file → Container path mapping (set in docker-compose.prod.yml):
#   ./keys/deposit-wallet.json  → /app/keys/deposit-wallet.json
#   ./keys/treasury-wallet.json → /app/keys/treasury-wallet.json
#
# Generate on server before first start:
#   solana-keygen new -o ./keys/deposit-wallet.json --no-bip39-passphrase
#   solana-keygen new -o ./keys/treasury-wallet.json --no-bip39-passphrase
#   chmod 600 ./keys/*.json
#
# CRITICAL: deposit-wallet and treasury-wallet MUST be different addresses.
# Verify: solana-keygen pubkey ./keys/deposit-wallet.json
#         solana-keygen pubkey ./keys/treasury-wallet.json
KEYPAIR_PATH=/app/keys/deposit-wallet.json
TREASURY_KEYPAIR_PATH=/app/keys/treasury-wallet.json

# Program IDs
# These match Anchor.toml. Change only if you redeployed the programs.
PROGRAM_ID=Dzpj74oeEhpyXwaiLUFKgzVz1Dcj4ZobsoczYdHiMaB3
ZK_VERIFIER_ID=2ntZ79MomBLsLyaExjGW6F7kkYtmprhdzZzQaMXSMZRu

# Relayer Network
# HOST/PORT are overridden in docker-compose.prod.yml to 0.0.0.0:8080
# Set here as fallback defaults.
HOST=0.0.0.0
PORT=8080

# Fee Configuration
# Fee in basis points (50 = 0.5%). Must match on-chain program config.
FEE_BPS=50

# RSA Signing Key
# Bit length for RSA blind signature key (2048 minimum for production)
RSA_KEY_BITS=2048

# Safety Flags
# ALLOW_UNSAFE_EMPTY_TREE: allow starting with no merkle state.
# false = production default (requires existing state or explicit override)
# true  = development only
ALLOW_UNSAFE_EMPTY_TREE=false

# ACCEPT_MERKLE_DATA_LOSS: allow continuing after detecting state is missing.
# false = production default
# true  = only set if you are doing a fresh deployment with no prior deposits
ACCEPT_MERKLE_DATA_LOSS=false

# Logging
# Controlled via docker-compose.prod.yml environment section.
# RUST_LOG=info,relayer=info,tower_http=warn
