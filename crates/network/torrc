# Bind to 0.0.0.0 to allow Docker containers to connect
# Access is restricted by SocksPolicy below
SocksPort 0.0.0.0:9050

DataDirectory /var/lib/tor

Log notice stdout

# SafeLogging 1 scrubs potentially sensitive information from logs
SafeLogging 1

# Accept connections from Docker internal network
# 172.16.0.0/12 covers Docker bridge networks
# 127.0.0.1 for localhost
SocksPolicy accept 172.16.0.0/12
SocksPolicy accept 127.0.0.1
# Reject all other connections (prevents external access)
SocksPolicy reject *
